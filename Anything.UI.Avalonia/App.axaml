<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Anything.UI.Avalonia.App"
             RequestedThemeVariant="{Binding CurrentThemeVariant}">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Anything.UI.Avalonia/Themes/Dark.axaml" />
    </Application.Styles>
</Application>

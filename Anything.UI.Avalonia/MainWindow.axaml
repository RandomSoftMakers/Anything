<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Anything.UI.Avalonia.ViewModels"
        x:Class="Anything.UI.Avalonia.Views.MainWindow"
        Title="Anything"
        Icon="/Assets/icon.png"
        Width="900"
        Height="500"
        Background="#1A1A1A"
        x:Name="MainWindowControl">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Custom title bar -->
        <Border Grid.Row="0"
                Background="#202020"
                PointerPressed="TitleBar_PointerPressed"
                x:Name="CustomTitleBar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding SearchWatermark}"
                           VerticalAlignment="Center"
                           Margin="12,0,8,0"
                           Foreground="White"
                           FontSize="14" />

                <TextBox Grid.Column="1"
                         Margin="0,4,8,4"
                         Background="#101010"
                         Foreground="White"
                         BorderBrush="#404040"
                         Padding="8"
                         FontSize="14"
                         Watermark="{Binding SearchWatermark}"
                         Text="{Binding Query, Mode=TwoWay}" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="0">
                    <Button Classes="titleButton"
                            Content="{Binding FiltersLabel}"
                            Click="ToggleFilters_Click"
                            Width="60"
                            Height="32"
                            ToolTip.Tip="{Binding FiltersLabel}" />
                    <Button Classes="titleButton"
                            Content="⚙"
                            Click="Settings_Click"
                            Width="46"
                            Height="32"
                            ToolTip.Tip="Settings" />
                    <Button Classes="titleButton"
                            Content="—"
                            Click="Minimize_Click"
                            Width="46"
                            Height="32" />
                    <Button Classes="titleButton"
                            Content="▢"
                            Click="Maximize_Click"
                            Width="46"
                            Height="32" />
                    <Button Classes="titleButton close"
                            Content="✕"
                            Click="Close_Click"
                            Width="46"
                            Height="32" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter panel (collapsible) -->
        <Border Grid.Row="1"
                Background="#252525"
                IsVisible="{Binding ShowFilters}"
                Padding="8">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding MatchCase}"
                          Foreground="White"
                          Content="{Binding MatchCaseLabel}" />
                <CheckBox IsChecked="{Binding MatchWholeWord}"
                          Foreground="White"
                          Content="{Binding WholeWordLabel}" />
                <CheckBox IsChecked="{Binding MatchPath}"
                          Foreground="White"
                          Content="{Binding MatchPathLabel}" />
                <CheckBox IsChecked="{Binding UseRegex}"
                          Foreground="White"
                          Content="{Binding RegexLabel}" />

                <TextBlock Text="{Binding TypeLabel}"
                           Foreground="#888888"
                           VerticalAlignment="Center" />
                <ComboBox SelectedIndex="{Binding TypeFilterIndex}"
                          Background="#101010"
                          Foreground="White"
                          Width="100">
                    <ComboBoxItem>All</ComboBoxItem>
                    <ComboBoxItem>Files</ComboBoxItem>
                    <ComboBoxItem>Folders</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="{Binding MinSizeLabel}"
                           Foreground="#888888"
                           VerticalAlignment="Center" />
                <TextBox Text="{Binding MinSize}"
                         Background="#101010"
                         Foreground="White"
                         BorderBrush="#404040"
                         Width="80" />

                <TextBlock Text="{Binding MaxSizeLabel}"
                           Foreground="#888888"
                           VerticalAlignment="Center" />
                <TextBox Text="{Binding MaxSize}"
                         Background="#101010"
                         Foreground="White"
                         BorderBrush="#404040"
                         Width="80" />
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2"
              Margin="12">
            <Grid RowDefinitions="Auto,*">
                <!-- Results info -->
                <TextBlock Grid.Row="0"
                           Text="{Binding ResultCountText}"
                           Foreground="#888888"
                           Margin="0,0,0,4" />

                <!-- Results list -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Results}"
                         Background="#101010"
                         Foreground="White"
                         BorderBrush="#404040"
                         DoubleTapped="ListBox_DoubleTapped"
                         Loaded="ListBox_Loaded">
                    <ListBox.DataTemplates>
                        <DataTemplate x:DataType="vm:FileEntryViewModel">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                  Margin="4">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           Foreground="#888888"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Path}"
                                           Foreground="#888888"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding SizeText}"
                                           Foreground="#666666" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.titleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.titleButton:pointerover">
            <Setter Property="Background" Value="#333333" />
        </Style>
        <Style Selector="Button.titleButton.close:pointerover">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

</Window>
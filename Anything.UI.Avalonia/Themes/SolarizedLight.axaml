<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Solarized Light - base: #fdf6e3, text: #657b83 -->
    <Style Selector="Window">
        <Setter Property="Background" Value="#FDF6E3" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="#657B83" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="Background" Value="#EEE8D5" />
        <Setter Property="Foreground" Value="#586E75" />
        <Setter Property="BorderBrush" Value="#93A1A1" />
        <Setter Property="CaretBrush" Value="#268BD2" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="#268BD2" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="#EEE8D5" />
        <Setter Property="Foreground" Value="#657B83" />
        <Setter Property="BorderBrush" Value="#93A1A1" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#657B83" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="#E4DDC8" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="#DAD2BB" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="#D0C8AE" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="#EEE8D5" />
    </Style>
    <Style Selector="Thumb">
        <Setter Property="Background" Value="#93A1A1" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#EEE8D5" />
        <Setter Property="Foreground" Value="#586E75" />
        <Setter Property="BorderBrush" Value="#93A1A1" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#657B83" />
    </Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="#EEE8D5" />
        <Setter Property="Foreground" Value="#586E75" />
        <Setter Property="BorderBrush" Value="#93A1A1" />
    </Style>
</Styles>
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- GNOME (light) - based on Adwaita -->
    <Style Selector="Window">
        <Setter Property="Background" Value="#F6F5F4" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="#2E3436" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#2E3436" />
        <Setter Property="BorderBrush" Value="#C0BFBC" />
        <Setter Property="CaretBrush" Value="#3584E4" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="#3584E4" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#2E3436" />
        <Setter Property="BorderBrush" Value="#C0BFBC" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#2E3436" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="#EDEDED" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="#D5E8FB" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="#BBD5F7" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="#F6F5F4" />
    </Style>
    <Style Selector="Thumb">
        <Setter Property="Background" Value="#9A9996" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#2E3436" />
        <Setter Property="BorderBrush" Value="#C0BFBC" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#2E3436" />
    </Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#2E3436" />
        <Setter Property="BorderBrush" Value="#C0BFBC" />
    </Style>
</Styles>
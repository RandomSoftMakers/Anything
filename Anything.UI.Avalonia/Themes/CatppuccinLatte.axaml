<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Catppuccin Latte (light) - base: #eff1f5, text: #4c4f69 -->
    <Style Selector="Window">
        <Setter Property="Background" Value="#EFF1F5" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="#4C4F69" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="Background" Value="#E6E9EF" />
        <Setter Property="Foreground" Value="#4C4F69" />
        <Setter Property="BorderBrush" Value="#9CA0B0" />
        <Setter Property="CaretBrush" Value="#EA76CB" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="#8839EF" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="#DCE0E8" />
        <Setter Property="Foreground" Value="#4C4F69" />
        <Setter Property="BorderBrush" Value="#BCC0CC" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#4C4F69" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="#CCD0DA" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="#BCC0CC" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="#ACB0BE" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="#DCE0E8" />
    </Style>
    <Style Selector="Thumb">
        <Setter Property="Background" Value="#ACB0BE" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#E6E9EF" />
        <Setter Property="Foreground" Value="#4C4F69" />
        <Setter Property="BorderBrush" Value="#9CA0B0" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#4C4F69" />
    </Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="#E6E9EF" />
        <Setter Property="Foreground" Value="#4C4F69" />
        <Setter Property="BorderBrush" Value="#9CA0B0" />
    </Style>
</Styles>
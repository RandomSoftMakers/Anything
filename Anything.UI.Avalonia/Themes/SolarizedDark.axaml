<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Solarized Dark - base: #002b36, text: #839496 -->
    <Style Selector="Window">
        <Setter Property="Background" Value="#002B36" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="#839496" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="Background" Value="#073642" />
        <Setter Property="Foreground" Value="#93A1A1" />
        <Setter Property="BorderBrush" Value="#586E75" />
        <Setter Property="CaretBrush" Value="#268BD2" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="#268BD2" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="#073642" />
        <Setter Property="Foreground" Value="#839496" />
        <Setter Property="BorderBrush" Value="#586E75" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#839496" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="#094452" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="#0B5263" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="#0D6074" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="#073642" />
    </Style>
    <Style Selector="Thumb">
        <Setter Property="Background" Value="#586E75" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#073642" />
        <Setter Property="Foreground" Value="#93A1A1" />
        <Setter Property="BorderBrush" Value="#586E75" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#839496" />
    </Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="#073642" />
        <Setter Property="Foreground" Value="#93A1A1" />
        <Setter Property="BorderBrush" Value="#586E75" />
    </Style>
</Styles>
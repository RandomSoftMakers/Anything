<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Breeze Dark (KDE) - base: #232629, text: #eff0f1 -->
    <Style Selector="Window">
        <Setter Property="Background" Value="#232629" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="#EFF0F1" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="Background" Value="#31363B" />
        <Setter Property="Foreground" Value="#EFF0F1" />
        <Setter Property="BorderBrush" Value="#505357" />
        <Setter Property="CaretBrush" Value="#3DAEE9" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="#3DAEE9" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="#31363B" />
        <Setter Property="Foreground" Value="#EFF0F1" />
        <Setter Property="BorderBrush" Value="#505357" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#EFF0F1" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="#3B4045" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="#454A4F" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="#4F5459" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="#232629" />
    </Style>
    <Style Selector="Thumb">
        <Setter Property="Background" Value="#505357" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#31363B" />
        <Setter Property="Foreground" Value="#EFF0F1" />
        <Setter Property="BorderBrush" Value="#505357" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#EFF0F1" />
    </Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="#31363B" />
        <Setter Property="Foreground" Value="#EFF0F1" />
        <Setter Property="BorderBrush" Value="#505357" />
    </Style>
</Styles>
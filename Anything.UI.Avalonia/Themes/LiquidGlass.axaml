<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Liquid Glass - Frosted glass-morphism design -->
    <Style Selector="Window">
        <Setter Property="Background" Value="#1A0A1E" />
    </Style>

    <Style Selector="UserControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.glassPanel">
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Border.glassPanelDark">
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Button.glassButton">
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.glassButton:pointerover">
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="BorderBrush" Value="#66FFFFFF" />
    </Style>

    <Style Selector="Button.glassButton:pressed">
        <Setter Property="Background" Value="#44FFFFFF" />
    </Style>

    <Style Selector="Button.glassAccent">
        <Setter Property="Background" Value="#4D7B61FF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#667B61FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.glassAccent:pointerover">
        <Setter Property="Background" Value="#667B61FF" />
    </Style>

    <Style Selector="Button.glassAccent:pressed">
        <Setter Property="Background" Value="#807B61FF" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="CaretBrush" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="#7B61FF" />
        <Setter Property="Background" Value="#26FFFFFF" />
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="#66FFFFFF" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="#267B61FF" />
    </Style>

    <Style Selector="ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="#337B61FF" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="#99FFFFFF" />
    </Style>

    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="#7B61FF" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Thumb">
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="MinHeight" Value="4" />
    </Style>

    <Style Selector="Thumb:pointerover">
        <Setter Property="Background" Value="#66FFFFFF" />
    </Style>

    <Style Selector="Thumb:pressed">
        <Setter Property="Background" Value="#99FFFFFF" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="#66FFFFFF" />
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="#7B61FF" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="#267B61FF" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>

</Styles>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Anything.UI.Avalonia.ViewModels"
             x:Class="Anything.UI.Avalonia.Views.MainView">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Glassmorphism gradient background layer -->
        <Rectangle Grid.RowSpan="4" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="#1A0A1E" />
                    <GradientStop Offset="0.3" Color="#1A0F2E" />
                    <GradientStop Offset="0.6" Color="#1E0A28" />
                    <GradientStop Offset="1.0" Color="#0F0A1E" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Search bar with glass effect -->
        <Border Grid.Row="0" Margin="12,12,12,4" CornerRadius="14" 
                Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                BoxShadow="0 4 24 0 #0A000000">
            <Grid ColumnDefinitions="*,Auto" Margin="4">
                <TextBox Grid.Column="0"
                         Background="Transparent"
                         Foreground="White"
                         BorderBrush="Transparent"
                         Padding="12,10"
                         FontSize="15"
                         Watermark="Search files..."
                         Text="{Binding Query, Mode=TwoWay}"
                         CornerRadius="10" />
                <Button Grid.Column="1"
                        Content="⚙"
                        Click="Settings_Click"
                        Width="40"
                        Height="40"
                        Background="Transparent"
                        Foreground="#AAFFFFFF"
                        CornerRadius="10"
                        FontSize="16"
                        BorderThickness="0" />
            </Grid>
        </Border>

        <!-- Filter panel (collapsible) -->
        <Border Grid.Row="1" Margin="12,4,12,4" CornerRadius="12"
                Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                IsVisible="{Binding ShowFilters}" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox IsChecked="{Binding MatchCase}" Foreground="White" Content="{Binding MatchCaseLabel}" />
                <CheckBox IsChecked="{Binding MatchWholeWord}" Foreground="White" Content="{Binding WholeWordLabel}" />
            </StackPanel>
        </Border>

        <!-- Results area -->
        <Grid Grid.Row="2" Margin="12,4,12,4">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" CornerRadius="10" Margin="0,0,0,4"
                        Background="#0DFFFFFF" Padding="8,4">
                    <TextBlock Text="{Binding ResultCountText}" 
                               Foreground="#AAFFFFFF" FontSize="12" />
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Results}"
                         Background="Transparent"
                         Foreground="White"
                         BorderBrush="Transparent"
                         DoubleTapped="ListBox_DoubleTapped">
                    <ListBox.DataTemplates>
                        <DataTemplate x:DataType="vm:FileEntryViewModel">
                            <Border CornerRadius="10" Margin="0,2" Padding="8,6"
                                    Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" 
                                               Foreground="#AAFFFFFF" Margin="0,0,10,0" FontSize="16" />
                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <TextBlock Text="{Binding Name}" Foreground="White" 
                                                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Path}" Foreground="#88FFFFFF" 
                                                   TextTrimming="CharacterEllipsis" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" 
                                               Foreground="#66FFFFFF" FontSize="12" 
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

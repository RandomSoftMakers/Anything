<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Anything.UI.Avalonia.ViewModels"
        x:Class="Anything.UI.Avalonia.Views.AboutWindow"
        Title="About Anything"
        Width="460"
        Height="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#202020">

    <Design.DataContext>
        <vm:AboutViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="24">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{Binding AppName}"
                       FontSize="28" FontWeight="Bold"
                       Foreground="White" />
            <TextBlock Text="{Binding Description}"
                       FontSize="14"
                       Foreground="#888888" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center">
            <TextBlock Foreground="#CCCCCC">
                <Run Text="Version: " />
                <Run Text="{Binding Version}" FontWeight="Bold" />
            </TextBlock>
            <TextBlock Foreground="#CCCCCC">
                <Run Text="License: " />
                <Run Text="{Binding License}" />
            </TextBlock>
            <TextBlock Foreground="#CCCCCC">
                <Run Text="Author: " />
                <Run Text="{Binding Author}" />
            </TextBlock>
            <TextBlock Foreground="#CCCCCC">
                <Run Text=".NET: " />
                <Run Text="{Binding DotNetVersion}" />
            </TextBlock>
            <TextBlock Foreground="#CCCCCC">
                <Run Text="OS: " />
                <Run Text="{Binding OsVersion}" />
            </TextBlock>
            <TextBlock Foreground="#CCCCCC">
                <Run Text="Build: " />
                <Run Text="{Binding BuildDate}" />
            </TextBlock>
            <Button Content="https://github.com/AnythingDevelopmentTeam/Anything"
                    Background="Transparent"
                    Foreground="#569CD6"
                    BorderThickness="0"
                    Click="GitHubLink_Click"
                    HorizontalAlignment="Left"
                    Cursor="Hand"
                    Margin="0,12,0,0" />
        </StackPanel>

        <Button Grid.Row="2"
                Content="Close"
                Background="Transparent"
                Foreground="#888888"
                BorderBrush="#444444"
                Click="Close_Click"
                HorizontalAlignment="Right"
                Padding="24,8" />
    </Grid>
</Window>
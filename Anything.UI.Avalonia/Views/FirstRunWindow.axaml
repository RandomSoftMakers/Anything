<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Anything.UI.Avalonia.ViewModels"
        x:Class="Anything.UI.Avalonia.Views.FirstRunWindow"
        Title="Welcome to Anything"
        Width="600"
        Height="400"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#202020">

    <Design.DataContext>
        <vm:FirstRunViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Spacing="8">
            <TextBlock Text="Welcome to Anything"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White" />
            <TextBlock Text="Let's get you set up quickly"
                       FontSize="14"
                       Foreground="#888888" />
        </StackPanel>

        <!-- Content -->
        <StackPanel Grid.Row="1"
                    Spacing="16"
                    VerticalAlignment="Center">
            <!-- Theme selection -->
            <StackPanel Spacing="8">
                <TextBlock Text="Choose your theme:"
                           Foreground="White"
                           FontSize="14" />
                <ComboBox SelectedIndex="{Binding SelectedThemeIndex}"
                          Background="#101010"
                          Foreground="White"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem>System</ComboBoxItem>
                    <ComboBoxItem>Dark</ComboBoxItem>
                    <ComboBoxItem>Light</ComboBoxItem>
                    <ComboBoxItem>Catppuccin Mocha</ComboBoxItem>
                    <ComboBoxItem>Catppuccin Latte</ComboBoxItem>
                    <ComboBoxItem>Solarized Dark</ComboBoxItem>
                    <ComboBoxItem>Solarized Light</ComboBoxItem>
                    <ComboBoxItem>VS Code Dark</ComboBoxItem>
                    <ComboBoxItem>GNOME</ComboBoxItem>
                    <ComboBoxItem>Breeze Dark</ComboBoxItem>
                    <ComboBoxItem>Breeze Light</ComboBoxItem>
                    <ComboBoxItem>Liquid Glass</ComboBoxItem>
                    </ComboBox>
            </StackPanel>

            <!-- Language selection -->
            <StackPanel Spacing="8">
                <TextBlock Text="Language:"
                           Foreground="White"
                           FontSize="14" />
                <ComboBox SelectedIndex="{Binding SelectedLanguageIndex}"
                          Background="#101010"
                          Foreground="White"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem>English</ComboBoxItem>
                    <ComboBoxItem>Русский</ComboBoxItem>
                    <ComboBoxItem>Deutsch</ComboBoxItem>
                    <ComboBoxItem>Français</ComboBoxItem>
                    <ComboBoxItem>Español</ComboBoxItem>
                    <ComboBoxItem>中文</ComboBoxItem>
                    <ComboBoxItem>日本語</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Skip"
                    Background="Transparent"
                    Foreground="#888888"
                    BorderBrush="#444444"
                    Click="Skip_Click"
                    Padding="16,8" />
            <Button Content="Get Started"
                    Background="#0078D4"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Click="GetStarted_Click"
                    Padding="16,8" />
        </StackPanel>
    </Grid>

</Window>

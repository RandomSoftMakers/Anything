<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Anything"
           Language="1033"
           Version="1.0.0"
           Manufacturer="RandomSoftMakers"
           UpgradeCode="3F2504E0-4F89-11D3-9A0C-0305E82C3301">

    <Package InstallerVersion="200"
              Compressed="yes"
              InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Anything is already installed." />

    <Media Id="1"
           Cabinet="product.cab"
           EmbedCab="yes" />

    <Feature Id="ProductFeature"
              Title="Anything"
              Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <Directory Id="TARGETDIR"
               Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER"
                   Name="Anything" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuSubfolder"
                   Name="Anything" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <ComponentGroup Id="ProductComponents"
                    Directory="INSTALLFOLDER">
      <Component Id="MainExecutable"
                 Guid="3F2504E0-4F89-11D3-9A0C-0305E82C3302">
        <File Id="AnythingExe"
              Source="$(var.SourceDir)\Anything.UI.Avalonia.exe"
              KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuSubfolder"
                    Name="Anything"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AnythingIcon.exe"
                    IconIndex="0" />
          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="Anything"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AnythingIcon.exe"
                    IconIndex="0" />
        </File>
      </Component>
      <Component Id="IconFile"
                 Guid="3F2504E0-4F89-11D3-9A0C-0305E82C3303">
        <File Id="IconPng"
              Source="$(var.SourceDir)\icon.png"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Icon Id="AnythingIcon.exe"
          SourceFile="$(var.SourceDir)\icon.png" />

  </Product>
</Wix>

[Unit]
Description=Anything File Indexer Daemon
Documentation=https://github.com/AnythingDevelopmentTeam/Anything
After=network.target local-fs.target

[Service]
Type=notify
ExecStart=/usr/lib/anything/anything-indexer
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

# Security hardening
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target

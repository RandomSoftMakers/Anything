<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="Anything"
             Language="1033"
             Version="$(var.Version)"
             Manufacturer="Anything Development Team"
             UpgradeCode="8791c140-98d9-4d3b-bac4-6d8e75a46588">

        <Package InstallerVersion="500"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Platform="x64" />

        <MediaTemplate EmbedCab="yes" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

        <Icon Id="app.ico" SourceFile="$(var.SolutionDir)icon.ico" />
        <Property Id="ARPPRODUCTICON" Value="app.ico" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLDIR" Name="AnythingUIQt">
                    <Component Id="AppShortcuts" Guid="*">
                        <Shortcut Id="StartMenuShortcut"
                                  Directory="ProgramMenuFolder"
                                  Name="Anything"
                                  WorkingDirectory="INSTALLDIR"
                                  Icon="app.ico"
                                  Target="[INSTALLDIR]AnythingUIQt.exe" />
                        <Shortcut Id="UninstallShortcut"
                                  Directory="ProgramMenuFolder"
                                  Name="Uninstall Anything"
                                  Target="[System64Folder]msiexec.exe"
                                  Arguments="/x [ProductCode]" />
                        <RegistryValue Root="HKCU"
                                       Key="Software\AnythingDevelopmentTeam\Anything"
                                       Name="installed"
                                       Type="integer"
                                       Value="1"
                                       KeyPath="yes" />
                        <RemoveFolder Id="RemoveProgramMenuDir"
                                      Directory="ProgramMenuFolder"
                                      On="uninstall" />
                    </Component>
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder" />
        </Directory>

        <Feature Id="ProductFeature" Title="Anything" Level="1">
            <ComponentRef Id="AppShortcuts" />
            <ComponentGroupRef Id="HarvestedFiles" />
        </Feature>
    </Product>
</Wix>
